{
  "name": "@tssuite/ggwsm",
  "version": "0.0.4",
  "description": "The gg command line, compiled to WebAssembly and runnable from Node via npx.",
  "keywords": [
    "gg",
    "cli",
    "dart",
    "wasm",
    "webassembly",
    "monorepo",
    "git",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./wasm": "./dist/bridge-wasm.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-version": "dart run scripts/sync_version.dart",
    "build:dart": "dart run build.dart",
    "build:dart:debug": "dart run build.dart --debug",
    "build:ts": "tsc -p tsconfig.build.json && vite build && dart run scripts/dist.dart finalize",
    "build": "pnpm run clean && pnpm run sync-version && pnpm run build:dart && pnpm run build:ts",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "clean": "dart run scripts/dist.dart clean",
    "test:dart": "dart test",
    "test:vitest": "vitest run --coverage",
    "test:node": "vitest run --project=node",
    "test:browser": "vitest run --project=browser",
    "test:coverage": "vitest run --coverage",
    "test": "pnpm run test:dart && pnpm run test:vitest && pnpm run lint && pnpm run format:check",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "vitest run --project=e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tssuite/dna-tssuite": "^0.1.1",
    "@tssuite/helix-js": "^0.1.0",
    "@types/node": "^26.4.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.3.3",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.12.0",
    "jsdoc": "^4.0.5",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tssuite/ggwsm.git"
  },
  "homepage": "https://github.com/tssuite/ggwsm#readme",
  "bugs": {
    "url": "https://github.com/tssuite/ggwsm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Dr. Gabriel Gatzsche",
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "bin": {
    "ggwsm": "./dist/ggwsm.mjs"
  }
}
